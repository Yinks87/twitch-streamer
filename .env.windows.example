# Windows / Docker Desktop: Kopie von .env.example für den Betrieb hinter Caddy (Port 3050).
# Kopieren nach .env im Repo-Root und Werte eintragen.
COMPOSE_FILE=docker-compose.yml;docker-compose.windows.yml

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_PERMITTED_USER=
TWITCH_REDIRECT_URI=https://DEINSUB.duckdns.org:3050/api/v1/auth/twitch/callback
SESSION_SECRET=

# Domain + DuckDNS-Token (https://www.duckdns.org) für das Let's-Encrypt-Zertifikat (DNS-Challenge)
DOMAIN=DEINSUB.duckdns.org
DUCKDNS_TOKEN=
