# Docker-Compose Umgebung (Produktivbetrieb auf der VPS).
# Kopieren nach .env im Repo-Root und Werte eintragen.

# Twitch-App (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Twitch-User-ID des Broadcasters, der streamen darf
TWITCH_PERMITTED_USER=

# Muss exakt so in der Twitch-Dev-Console als OAuth Redirect URL eingetragen sein
TWITCH_REDIRECT_URI=https://DEINSUB.duckdns.org/api/v1/auth/twitch/callback

# Zufälliger langer String, z. B. via: openssl rand -hex 32
SESSION_SECRET=

