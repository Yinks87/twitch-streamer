# Copy this file to .env and adjust as needed
PORT=4000

# Absolute path to the folder where uploaded videos are stored.
VIDEOS_DIR=./videos

# Path to the sqlite database file
DB_PATH=./data.sqlite

# Path to the ffmpeg binary. "ffmpeg" works if it's on the PATH.
FFMPEG_PATH=ffmpeg

# Path to yt-dlp binary used to download Twitch VODs.
YTDLP_PATH=yt-dlp

# ── Twitch OAuth ──────────────────────────────────────────────────────────────
# Create an app at https://dev.twitch.tv/console and add the redirect URI below
# to your app's "OAuth Redirect URLs".
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Permitted Twitch User ──────────────────────────────────────────────────────
# The Twitch username that is permitted to use this application as a broadcaster to stream content on his channel.
TWITCH_PERMITTED_USER=

# Must match exactly what you registered in the Twitch dev console.
# Production: https://yourdomain.com/api/auth/twitch/callback
# Local dev:  http://localhost:4000/api/auth/twitch/callback
TWITCH_REDIRECT_URI=http://localhost:4000/api/auth/twitch/callback

# Where the browser lands after OAuth completes.
# Production: leave empty (same origin via nginx proxy).
# Local dev:  set to http://localhost:5173 (Vite dev server).
FRONTEND_URL=http://localhost:5173

# Random secret used to generate session tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

